# Response headers Cloudflare Workers static assets applies to every path.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# The pages carry no inline script or style, so the policy needs no 'unsafe-inline' and
# no hash. A page that adds an inline <style>, a style="" attribute or an inline script
# is blocked by the browser until the policy is widened on purpose. Google Fonts is the
# one outside origin. HSTS is left to the Cloudflare zone (SSL/TLS > Edge Certificates).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
# Static caching. Asset file names are not content-hashed, so the lifetimes stay short and a
# release shows up within the hour (assets) or five minutes (data). Assets are fresh for half
# an hour and may be served stale for another half hour while they revalidate, so an old
# script or style never outlives new markup by more than one hour.
# The pages are not listed: HTML keeps the platform default and revalidates on every visit.
# The rules match the request path, so a missing /assets/ or /data/ file answers its 404
# page with the same lifetime.
/assets/*
  Cache-Control: public, max-age=1800, stale-while-revalidate=1800
/data/*
  Cache-Control: public, max-age=300
